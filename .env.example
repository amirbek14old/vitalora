# PostgreSQL connection (Neon, Supabase, Vercel Postgres, RDS ...)
DATABASE_URL="postgresql://vitalora:vitalora@localhost:5432/vitalora?schema=public"

# Public base URL (used for origin checks)
APP_URL="http://localhost:3000"

# AI provider: "gemini" (free key: aistudio.google.com/apikey) | "anthropic" | "openai" (any OpenAI-compatible API).
# Leave empty to disable AI features. Free example: AI_PROVIDER="gemini", AI_MODEL="gemini-2.5-flash"
AI_PROVIDER=""
AI_API_KEY=""
# Model id for text chat and for food-photo analysis (must support images)
AI_MODEL=""
AI_VISION_MODEL=""
# Optional custom base URL for OpenAI-compatible providers (set automatically for gemini)
AI_BASE_URL=""
# Optional: reasoning effort sent to OpenAI-compatible APIs (for gemini-2.5-flash it defaults to "none")
AI_REASONING_EFFORT=""

# Secret for the retention cron endpoint (/api/cron/retention)
CRON_SECRET="change-me"

# First admin account created by the seed script
SEED_ADMIN_EMAIL="admin@vitalora.local"
SEED_ADMIN_PASSWORD="ChangeThisAdminPassword!2026"

# --- Pro payments ($5 → 14 days of Pro). Leave empty to hide the pay buttons. ---
# Public site address, used for the "return to site" link after payment
APP_URL="https://vitalora-phi.vercel.app"
# Price in soʻm (≈ $5). Update when the exchange rate changes.
PRO_PRICE_UZS="65000"
# Payme (business.payme.uz → Cashbox). Endpoint for Payme: https://<site>/api/payments/payme
PAYME_MERCHANT_ID=""
PAYME_KEY=""
# "1" = test mode (checkout.test.paycom.uz, use the TEST key)
PAYME_TEST="1"
# Click (merchant.click.uz). Prepare URL: https://<site>/api/payments/click/prepare
#                            Complete URL: https://<site>/api/payments/click/complete
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
